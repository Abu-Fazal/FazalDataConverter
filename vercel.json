{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/shell.html"
    },
    {
      "source": "/account",
      "destination": "/shell.html"
    },
    {
      "source": "/history",
      "destination": "/shell.html"
    },
    {
      "source": "/login",
      "destination": "/shell.html"
    },
    {
      "source": "/converter/progress/:path*",
      "destination": "/shell.html"
    },
    {
      "source": "/converter/error/:path*",
      "destination": "/shell.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}