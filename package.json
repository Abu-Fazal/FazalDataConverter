{
  "name": "fazaldataconverter-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Secure web-based bidirectional converter for Excel and JSON files",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend & npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=frontend",
    "test:watch": "npm run test:watch --workspace=frontend"
  },
  "keywords": [
    "excel",
    "json",
    "bson",
    "converter",
    "data-converter"
  ],
  "author": "Fazal",
  "license": "UNLICENSED"
}
