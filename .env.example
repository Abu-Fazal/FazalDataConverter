# ==============================================================================
# FazalDataConverter — Environment Configuration Template
# Populate real values locally in .env (never commit .env to git)
#
# How to use:
#   1. Copy this file to .env in the repo root:  cp .env.example .env
#      (PowerShell: Copy-Item .env.example .env)
#   2. Replace the placeholders with your real values.
#   3. Restart the backend (`npm run dev:backend`) — dotenv loads backend/.env
#      first, then this repo-root .env as a fallback.
#   4. Verify .env is listed in .gitignore and never commit it.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=your_mongodb_atlas_uri_here

# Session & Security
SESSION_SECRET=replace_with_a_secure_random_string_min_32_chars
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173

# Google OAuth 2.0 Credentials
# Leave GOOGLE_CLIENT_ID unset/placeholder to use the dev mock Google sign-in.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Sole Admin credentials (required for real admin sign-in)
# Leave BOTH unset to keep dev mock mode: any email + any password is accepted
# with the admin role. Set BOTH to enable real bcrypt authentication.
#
# Generate the hash from the backend workspace (bcrypt is already installed):
#   cd backend && node -e "require('bcrypt').hash('YOUR_PASSWORD_HERE', 12).then(console.log)"
# Paste the full $2b$12$... output below, then restart the backend.
# Never store the plaintext password here. 5 failed attempts = 15-minute lockout.
# ADMIN_EMAIL=admin@fazaldataconverter.com
# ADMIN_PASSWORD_HASH=$2b$12$replace_with_generated_bcrypt_hash

# Cloudflare R2 Storage (S3-Compatible API)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=fazaldataconverter-storage
R2_PUBLIC_DOMAIN=https://storage.fazaldataconverter.com

# Conversion Engine Boundaries
MAX_FILE_SIZE_BYTES=52428800
JOB_TIMEOUT_SECONDS=60
TEMP_STORAGE_PATH=./backend/storage/temp

# ==============================================================================
# Vercel deployment (frontend and backend can share one project or be split)
# ==============================================================================
# Backend env vars (set in the Vercel project settings, never commit real values):
#   SESSION_SECRET, CORS_ORIGIN, MONGODB_URI, GOOGLE_CLIENT_ID, ADMIN_EMAIL,
#   ADMIN_PASSWORD_HASH, R2_* credentials.
# On Vercel the backend automatically stores temp files in /tmp/fazal-storage.
# CORS_ORIGIN accepts a comma-separated list, e.g.
#   https://fazaldataconverter.com,https://fazaldataconverter-git-main.vercel.app
#
# Frontend build var (Vite, baked in at build time):
#   Leave unset when the frontend and /api functions deploy to the same domain.
#   Set it only when the API lives on a separate Vercel project/domain:
# VITE_API_URL=https://fazaldataconverter-api.vercel.app/api
